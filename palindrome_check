from fastapi import FastAPI

app=FastAPI()

def is_palindrome(s:str):
    cleaned_str=''.join(c.lower() for c in s if c.isalnum())
    return cleaned_str == cleaned_str[::-1]
                                      
@app.get("/palindrome/{input_string}")
def check_palindrome(input_string:str):
    result_is_palindrome = is_palindrome(input_string)
    return{"input_string": input_string, "is_palindrome": result_is_palindrome}

